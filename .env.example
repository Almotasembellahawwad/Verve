# Optional canonical URL used by metadata, robots.txt, and sitemap.xml.
# Provider and Pexels keys stay in the browser key manager; do not add them here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Distributed admission control. Recommended on every Vercel environment.
# Use separate Redis databases/tokens for Preview and Production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional distributed admission control. Verve falls back to an in-process limiter
# when these values are absent so generation remains available during setup.
